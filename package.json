{
  "name": "systematic-sales-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:connected": "node init && vite --mode development --host localhost --strictPort",
    "build:connected": "node init && tsc -b && vite build --mode production",
    "dev": "node init && vite --mode showcase --host localhost --strictPort",
    "dev:showcase": "node init && vite --mode showcase --host localhost --strictPort",
    "build:showcase": "node init && tsc -b && vite build --mode showcase --base ./ --outDir dist-showcase",
    "preview:showcase": "vite preview --outDir dist-showcase --host localhost --port 4173 --strictPort",
    "build": "node init && tsc -b && vite build --mode showcase --base ./ --outDir dist-showcase",
    "preview": "vite preview --outDir dist-showcase --host localhost --port 4173 --strictPort",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "dotenv": "^8.2.0",
    "lucide-react": "0.468.0",
    "node-fetch": "^3.3.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "5.0.2"
  }
}
